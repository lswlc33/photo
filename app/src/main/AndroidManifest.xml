<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!--
        The only permission here that is not about reading media, and the only one
        the app can hold without ever using: update checking needs it, and update
        checking is off until the user turns it on in Settings.

        It has to be declared rather than requested. INTERNET is a normal
        permission, granted by the system at install time with no prompt and no
        way to revoke it, so "ask for it when the switch is turned on" is not
        something Android offers. What the switch actually gates is every call
        site: UpdateViewModel refuses to check while it is off, and it is the one
        place in the codebase that opens a socket. With the switch off the app
        holds a permission it never exercises.

        That distinction is what README.md, index.html and the About page state,
        and it is the only honest way to word it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoOrganizer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
