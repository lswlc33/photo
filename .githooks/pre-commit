#!/bin/sh
# Pre-commit gate. Enable once with:
#
#     git config core.hooksPath .githooks
#
# Why this exists: a commit that does not compile can only ever be found by
# bisecting into it. AGENTS.md declares that every commit must build on its own;
# this makes that declaration machine-checked instead of remembered, and catches
# it before the push rather than in CI a minute later.
#
# `:app:test` compiles the debug sources and the unit tests, so it catches
# compile errors as well as test failures. Lint is deliberately not run here
# (~50 s); use tools/verify.sh before a release instead.
#
# tools/check-workflows.sh runs first and costs nothing. It is here rather than
# only in CI because a workflow file GitHub cannot parse fails the run in 0 s
# without starting a job: the file that broke CI is the file its own CI cannot
# check.
#
# Escape hatch for a deliberate work-in-progress commit:
#
#     SKIP_VERIFY=1 git commit ...
set -e

if [ -n "$SKIP_VERIFY" ]; then
    echo "pre-commit: skipped (SKIP_VERIFY is set)"
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# First, because it takes milliseconds: see the header for why CI cannot be the
# gate for its own workflow file.
echo "pre-commit: tools/check-workflows.sh"
if ! tools/check-workflows.sh; then
    echo
    echo "pre-commit: workflow check failed - commit aborted."
    exit 1
fi

echo "pre-commit: ./gradlew :app:test"
if ! ./gradlew :app:test --console=plain --quiet; then
    echo
    echo "pre-commit: :app:test failed - commit aborted."
    echo "            Fix it, or use SKIP_VERIFY=1 to commit anyway."
    exit 1
fi
